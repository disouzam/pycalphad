{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "justMyCode": true,
            "stopOnEntry": false,
            "console": "integratedTerminal",
            "cwd": "${fileDirname}",
        },
        {
            "name": "Debug Cosmic-Ray execution - Http distributors",
            "type": "debugpy",
            "request": "launch",
            "module": "cosmic_ray.cli",
            "args": [
                "exec",
                "mutation_testing/02_workers/cosmic-ray-02-workers.toml",
                "mutation_testing/02_workers/cosmic-ray-02-workers.sqlite"
            ],
            "justMyCode": true,
            "stopOnEntry": false,
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "Debug Cosmic-Ray worker",
            "type": "debugpy",
            "request": "launch",
            "module": "cosmic_ray.cli",
            "args": [
                "--verbosity",
                "DEBUG",
                "http-worker",
                "--port",
                "9001"
            ],
            "justMyCode": true,
            "stopOnEntry": false,
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/worker1",
        },
        {
            "name": "Debug Cosmic-Ray execution - Local distributor",
            "type": "debugpy",
            "request": "launch",
            "module": "cosmic_ray.cli",
            "args": [
                "exec",
                "mutation_testing/local_distributor/cosmic-ray-local-distributor.toml",
                "mutation_testing/local_distributor/cosmic-ray-for-local-distributor.sqlite"
            ],
            "justMyCode": false,
            "stopOnEntry": true,
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "Debug pytest execution with reports",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests",
                "--template=html1/index.html",
                "--report=report.html",
                "-s"
            ],
            "justMyCode": false,
            "stopOnEntry": false,
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "Debug pytest execution - No reports",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests",
            ],
            "justMyCode": false,
            "stopOnEntry": false,
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
        }
    ]
}